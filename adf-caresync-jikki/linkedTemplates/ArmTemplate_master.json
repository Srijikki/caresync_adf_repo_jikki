{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-jikki"
		},
		"ls_postgresql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_postgresql'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncprojectjikki.dfs.core.windows.net/"
		},
		"ls_azuredatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1119-070142-rid14syj"
		},
		"ls_azuresqldatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server-jikki.database.windows.net"
		},
		"ls_azuresqldatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"ls_azuresqldatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "srijikki"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-keyvault-jikki.vault.azure.net/"
		},
		"ls_postgresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-falling-snow-azboze8c-pooler.c-3.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgresql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-jikki_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_postgresql_password": {
						"value": "[parameters('ls_postgresql_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_postgresql_properties_typeProperties_server": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_server')]"
					},
					"ls_postgresql_properties_typeProperties_database": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_database')]"
					},
					"ls_postgresql_properties_typeProperties_username": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_username')]"
					},
					"ls_azuredatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_azuredatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_azuresqldatabase_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldatabase_properties_typeProperties_server')]"
					},
					"ls_azuresqldatabase_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldatabase_properties_typeProperties_database')]"
					},
					"ls_azuresqldatabase_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}